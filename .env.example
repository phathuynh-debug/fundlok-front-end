# Canonical public URL (no trailing slash) — used for sitemap.xml, robots.txt,
# canonicals, and structured data. Must match the domain submitted to Google
# Search Console exactly (www vs non-www matters).
NEXT_PUBLIC_SITE_URL=https://fundlok.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=YOUR_SITE_KEY_HERE
# Set to true to disable Cloudflare Turnstile in local development
NEXT_PUBLIC_DISABLE_TURNSTILE=false

# Set to true to skip the KYC/KYB route gates in local development, so an SME
# can reach /project-application (and an investor /dashboard/invest) without
# GVerify partner credentials configured on the backend. Server-only on
# purpose — do NOT rename this to NEXT_PUBLIC_*, or it becomes flippable from
# the browser. Ignored entirely when NODE_ENV=production. See proxy.ts.
SKIP_VERIFICATION_GATES=false

# Local testing only: set to false to hide the identity (KYC) step on the SME's
# KYB screen, e.g. when testing with a sample certificate that belongs to
# someone else. Ignored in production builds (the step is always shown there).
# Pair it with GVERIFY_KYB_REQUIRE_REP_MATCH=false in the backend .env, or the
# backend refuses the KYB submission for lack of a KYC.
NEXT_PUBLIC_GVERIFY_KYB_REQUIRE_REP_MATCH=true

# Shared secret proving a request to FastAPI came from this app. Every Next →
# FastAPI call carries it as the X-Backend-Secret header (see
# lib/backend-secret.ts), so a Cloudflare rule in front of the backend origin
# can drop anything arriving without it — closing the route that skips the
# frontend and hits the API directly.
#
# Generate with:  openssl rand -hex 32
#
# Server-only on purpose — do NOT rename to NEXT_PUBLIC_*, or the secret is
# inlined into the client bundle and stops being a secret. The backend must be
# configured with the SAME value.
#
# Unset locally is fine: the header is simply omitted and a warning is logged.
BACKEND_SECRET_KEY=

# PartyKit host for live notification pushes (no scheme). Public by design —
# the secrets live on the backend and in `partykit env`. Leave unset to stay on
# polling. Local: localhost:1999 (npm run party:dev). The backend needs the
# matching PARTYKIT_HOST / PARTYKIT_JWT_SECRET / PARTYKIT_PUBLISH_SECRET.
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999