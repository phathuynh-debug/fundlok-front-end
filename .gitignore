# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# The glob covers the alternate dist dirs NEXT_DIST_DIR is pointed at (the E2E
# suite uses .next-e2e). Leaving one untracked is not just clutter: Tailwind v4
# auto-detects sources by scanning everything git does not ignore, and it will
# happily extract garbage "utilities" out of compiled binary chunks, which then
# fail to parse as CSS.
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

certificates

# Playwright
/e2e/.artifacts/
/playwright-report/
/blob-report/
/test-results/

# E2E build output
/.next-e2e/

# vbsec security scan reports and fix logs: they list unfixed vulnerabilities
# by file and line, so they never go into git (or a deployment).
vbsec-reports/
.vbsec-tmp/
