{
  "name": "fundlok-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build --webpack && node scripts/deploy-partykit.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix && prettier --write .",
    "i18n:sort": "bun scripts/sort-i18n.ts",
    "i18n:check": "bun scripts/sort-i18n.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:style": "prettier --check .",
    "ci": "bun scripts/ci.ts",
    "ci:check": "bun scripts/ci.ts",
    "ci:fix": "bun scripts/ci.ts --fix",
    "party:dev": "npm --prefix party run dev",
    "party:deploy": "npm --prefix party run deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky install",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "e2e:stub-api": "bun e2e/stub-api/server.ts"
  },
  "dependencies": {
